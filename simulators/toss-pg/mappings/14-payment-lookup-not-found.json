{
  "priority": 5,
  "request": {
    "method": "GET",
    "urlPathPattern": "/v1/payments/.*not-approved-timeout.*",
    "headers": {
      "Authorization": {
        "equalTo": "Basic dGVzdC1zZWNyZXQta2V5Og=="
      }
    }
  },
  "response": {
    "status": 404,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "code": "NOT_FOUND_PAYMENT",
      "message": "Payment not found"
    }
  }
}
