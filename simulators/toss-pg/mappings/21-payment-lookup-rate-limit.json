{
  "priority": 5,
  "request": {
    "method": "GET",
    "urlPathPattern": "/v1/payments/.*lookup-rate-limit.*",
    "headers": {
      "Authorization": {
        "equalTo": "Basic dGVzdC1zZWNyZXQta2V5Og=="
      }
    }
  },
  "response": {
    "status": 429,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "code": "TOO_MANY_REQUESTS",
      "message": "Too many lookup requests"
    }
  }
}
