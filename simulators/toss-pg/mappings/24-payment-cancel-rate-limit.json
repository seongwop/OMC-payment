{
  "priority": 10,
  "request": {
    "method": "POST",
    "urlPathPattern": "/v1/payments/.*cancel-rate-limit.*/cancel",
    "headers": {
      "Authorization": {
        "equalTo": "Basic dGVzdC1zZWNyZXQta2V5Og=="
      }
    }
  },
  "response": {
    "status": 429,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "code": "TOO_MANY_REQUESTS",
      "message": "Too many cancel requests"
    }
  }
}
