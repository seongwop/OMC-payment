{
  "priority": 10,
  "request": {
    "method": "POST",
    "urlPathPattern": "/v1/payments/.*cancel-server-error.*/cancel",
    "headers": {
      "Authorization": {
        "equalTo": "Basic dGVzdC1zZWNyZXQta2V5Og=="
      }
    }
  },
  "response": {
    "status": 500,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "code": "CANCEL_FAILED",
      "message": "PG cancel server error"
    }
  }
}
