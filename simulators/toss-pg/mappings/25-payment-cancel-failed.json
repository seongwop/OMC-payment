{
  "priority": 10,
  "request": {
    "method": "POST",
    "urlPathPattern": "/v1/payments/.*cancel-failed.*/cancel",
    "headers": {
      "Authorization": {
        "equalTo": "Basic dGVzdC1zZWNyZXQta2V5Og=="
      }
    }
  },
  "response": {
    "status": 400,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "code": "CANCEL_NOT_ALLOWED",
      "message": "Payment cannot be canceled"
    }
  }
}
