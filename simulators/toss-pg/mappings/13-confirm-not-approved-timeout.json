{
  "priority": 5,
  "request": {
    "method": "POST",
    "url": "/v1/payments/confirm",
    "headers": {
      "Authorization": {
        "equalTo": "Basic dGVzdC1zZWNyZXQta2V5Og=="
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.paymentKey =~ /.*not-approved-timeout.*/)]"
      }
    ]
  },
  "response": {
    "status": 504,
    "fixedDelayMilliseconds": 5000,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "code": "GATEWAY_TIMEOUT",
      "message": "Timeout before PG approval"
    }
  }
}
