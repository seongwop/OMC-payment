{
  "priority": 100,
  "request": {
    "method": "POST",
    "url": "/v1/payments/confirm",
    "headers": {
      "Authorization": {
        "equalTo": "Basic dGVzdC1zZWNyZXQta2V5Og=="
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": "{\n  \"paymentKey\": \"{{jsonPath request.body '$.paymentKey'}}\",\n  \"lastTransactionKey\": \"mock-confirm-{{jsonPath request.body '$.orderId'}}\",\n  \"orderId\": \"{{jsonPath request.body '$.orderId'}}\",\n  \"totalAmount\": {{jsonPath request.body '$.amount'}},\n  \"status\": \"DONE\"\n}"
  }
}
